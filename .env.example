# ---------------------------------------------------------------------------
# SIWS Platform — environment template.
# Copy to `.env` and fill in. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URI=postgres://USER:PASSWORD@127.0.0.1:5432/siws

# Payload signing secret. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# BR-EDIT-04 — "preview changes before publishing". The preview route rejects
# any request without this, so leaving it blank disables both the Preview
# button and the live-preview pane. Generate as for PAYLOAD_SECRET:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PREVIEW_SECRET=

# Public origin, used for canonical URLs, sitemap, Open Graph and email links.
# No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# BR-SEO-08 — staging must never be indexed. Set to `true` ONLY on production.
NEXT_PUBLIC_ENABLE_INDEXING=false
